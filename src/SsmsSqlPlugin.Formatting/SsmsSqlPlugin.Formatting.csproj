<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SsmsSqlPlugin.Formatting</AssemblyName>
    <RootNamespace>SsmsSqlPlugin.Formatting</RootNamespace>
    <Ssms21Build Condition="'$(Configuration)'=='Debug21' Or '$(Configuration)'=='Release21'">true</Ssms21Build>
    <Ssms20Build Condition="'$(Configuration)'=='Debug20' Or '$(Configuration)'=='Release20'">true</Ssms20Build>
    <DefineConstants Condition="'$(Ssms21Build)'=='true'">$(DefineConstants);SSMS21</DefineConstants>
    <DefineConstants Condition="'$(Ssms20Build)'=='true'">$(DefineConstants);SSMS20</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- ScriptDom 由宿主提供，**不复制到输出目录**。
         SSMS 22：18.x；SSMS 21：17.x；SSMS 20：16.1（x86）。
         用 Debug21/Release21、Debug20/Release20 配置切到对应包，
         避免跨大版本强名称绑定失败。 -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="161.9142.1"
                      Condition="'$(Ssms20Build)'=='true'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0"
                      Condition="'$(Ssms21Build)'=='true'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0"
                      Condition="'$(Ssms21Build)'!='true' And '$(Ssms20Build)'!='true'">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
